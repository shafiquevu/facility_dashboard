# Same Supabase project as dashboard.gomcgrath.com (same accounts and roles).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# .gomcgrath.com in production, so one sign-in covers both apps.
# Set the same value on the dashboard (ai_dashboard) too.
AUTH_COOKIE_DOMAIN=

# The Back to Dashboard link.
NEXT_PUBLIC_MAIN_DASHBOARD_URL=https://dashboard.gomcgrath.com

# The hangar service (Railway). Server-side only; same key the dashboard uses.
FACILITY_MAINTENANCE_URL=
FACILITY_CONNECTOR_KEY=

# Local development only: skips the login with this name. Ignored in production builds.
# FACILITY_DEV_USER=Your Name
